# Copy this file to .env and replace the placeholders. Never commit .env.

# PostgreSQL connection string. The user, password and port must match
# docker-compose.yml (the container publishes PostgreSQL on localhost:5433).
DATABASE_URL=postgresql://dopamine:<db-password>@localhost:5433/dopaminestore

# Secret key used to sign JWT access tokens (HS256). Use a long random string,
# e.g. the output of: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<replace-with-a-long-random-secret>

# Lifetime of access tokens, in minutes
ACCESS_TOKEN_MINUTES=30

# Lifetime of refresh tokens, in days
REFRESH_TOKEN_DAYS=7
